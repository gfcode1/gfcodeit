{
  "name": "gfcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A static, PWA-ready framework that hosts a collection of mini apps.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:framework": "node scripts/build-framework.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.mjs",
    "build:rss-catalog": "node scripts/build-rss-catalog.mjs",
    "validate:apps": "node scripts/validate-apps.mjs",
    "predev": "pnpm build:icons && pnpm build:pwa-icons && pnpm build:framework && pnpm build:rss-catalog",
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "prebuild": "pnpm validate:apps && pnpm build:icons && pnpm build:pwa-icons && pnpm build:framework && pnpm build:rss-catalog",
    "build": "vite build",
    "desktop:build": "node desktop/build.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:start": "node desktop/start.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size-report": "node scripts/size-report.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs",
    "new-app": "node scripts/new-app.mjs",
    "sounds:sync": "node scripts/sync-soundscape-sounds.mjs",
    "sounds:optimize": "node scripts/optimize-soundscape-sounds.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^44.4.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "openmoji": "^17.0.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  }
}
