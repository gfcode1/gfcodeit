{
  "name": "gfcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A static, PWA-ready framework that hosts a collection of mini apps.",
  "scripts": {
    "build:framework": "node scripts/build-framework.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.mjs",
    "validate:apps": "node scripts/validate-apps.mjs",
    "predev": "pnpm build:icons && pnpm build:pwa-icons && pnpm build:framework",
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "prebuild": "pnpm validate:apps && pnpm build:icons && pnpm build:pwa-icons && pnpm build:framework",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs",
    "new-app": "node scripts/new-app.mjs",
    "sounds:sync": "node scripts/sync-soundscape-sounds.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "openmoji": "^17.0.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
